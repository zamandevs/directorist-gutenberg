{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "directorist-gutenberg/listing-card-template",
	"version": "0.1.0",
	"title": "Listing Card Template",
	"description": "Composable listing card template container.",
	"category": "directorist-listings-archive",
	"attributes": {
		"view": {
			"description": "Card view variation.",
			"type": "string",
			"default": "grid"
		},
		"block_width": {
			"description": "Block width percentage.",
			"type": "string",
			"default": "100"
		}
	},
	"supports": {
		"html": false
	},
	"usesContext": [
		"directorist-gutenberg/directoryTypeId",
		"directorist-gutenberg/contextMode",
		"directorist-gutenberg/instanceId"
	],
	"textdomain": "directorist-gutenberg",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
